  "_copilot_yaml": "title: Extract main heading from example.com\nworkflow_definition:\n  parameters: []\n  blocks:\n  - block_type: code\n    label: extract_main_heading\n    prompt: The example.com page is open, its main heading text is returned as heading,\n      the first paragraph of the page is returned as paragraph, the browser tab title\n      is returned as title, and the visible text of every link on the page is returned\n      as links. The block opens https://example.com, waits for the page body text\n      to render, reads the first h1 if one exists (otherwise the first paragraph),\n      separately reads the first p element on the page, and collects the text of every\n      a element.\n    code: \"await page.goto(\\\"https://example.com\\\")\\nawait page.wait_for_selector(\\\"\\\n      body p\\\")\\nh1 = page.locator(\\\"h1\\\")\\nif await h1.count() > 0:\\n    heading\\\n      \\ = (await h1.first.inner_text()).strip()\\n    source = \\\"h1\\\"\\nelse:\\n    heading\\\n      \\ = (await page.locator(\\\"p\\\").first.inner_text()).strip()\\n    source = \\\"\\\n      first_paragraph\\\"\\nparagraph = (await page.locator(\\\"p\\\").first.inner_text()).strip()\\n\\\n      title = await page.title()\\nlink_texts = await page.locator(\\\"a\\\").all_inner_texts()\\n\\\n      links = [t.strip() for t in link_texts if t.strip()]\\nreturn {\\\"heading\\\": heading,\\\n      \\ \\\"source\\\": source, \\\"paragraph\\\": paragraph, \\\"title\\\": title, \\\"links\\\"\\\n      : links}\"\n    data_schema:\n      type: object\n      properties:\n        heading:\n          type: string\n        source:\n          type: string\n        paragraph:\n          type: string\n        title:\n          type: string\n        links:\n          type: array\n          items:\n            type: string\n      required:\n      - heading\n      - paragraph\n      - links\n    steps:\n    - description: Open https://example.com\n      action_type: goto_url\n      line_start: 1\n      line_end: 1\n    - description: Extract heading\n      action_type: extract\n      line_start: 5\n      line_end: 8\n    - description: Extract paragraph\n      action_type: extract\n      line_start: 10\n      line_end: 10\n    - description: Extract link texts\n      action_type: extract\n      line_start: 12\n      line_end: 12\n",
