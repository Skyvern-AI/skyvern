# Browser streaming mode:
# - cdp: use local browser streaming through the backend
# - vnc: use VNC streaming
# Quickstart writes cdp for new local installs; app code falls back to vnc if unset.
VITE_BROWSER_STREAMING_MODE=cdp

# Where the BROWSER reaches the API. This is the one that gets baked into the built
# bundle, so it has to be an address the end user's browser can resolve.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Where the UI SERVER itself reaches the API, for the requests it makes on its own
# (minting browser sessions, proxying). Optional, and it takes precedence over
# VITE_API_BASE_URL for those server-side calls only.
#
# Set this when the browser-facing address is not one the UI server can use --
# typically when VITE_API_BASE_URL points at an external load balancer or a public
# hostname that does not resolve from inside the network the UI server runs in.
# Left unset, the UI server falls back to VITE_API_BASE_URL, except in a container
# where a loopback VITE_API_BASE_URL is swapped for http://skyvern:8000/api/v1.
# SKYVERN_API_BASE_URL=http://skyvern:8000/api/v1

# server to load artifacts from file URIs
VITE_ARTIFACT_API_BASE_URL=http://localhost:9090

# websocket
# VITE_WSS_BASE_URL=wss://api-staging.skyvern.com/api/v1
VITE_WSS_BASE_URL=ws://localhost:8000/api/v1

# your api key - for x-api-key header
VITE_SKYVERN_API_KEY=YOUR_API_KEY

# Enable recording skyvern logs as artifacts
VITE_ENABLE_LOG_ARTIFACTS=false

# Enable code block node
VITE_ENABLE_CODE_BLOCK=true

# Enable 2FA verification code notifications (toasts, sounds, OS notifications, WebSocket streaming)
# Set to "false" to disable for orgs with high task/workflow volume
VITE_ENABLE_2FA_NOTIFICATIONS=true
