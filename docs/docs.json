{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Skyvern",
  "integrations": {
    "cookies": {
      "key": "skyvern_docs_telemetry",
      "value": "granted"
    }
  },
  "colors": {
    "primary": "#4A6CF7",
    "light": "#7B93FA",
    "dark": "#1B2559"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#F8F5EF",
      "dark": "#1C1917"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "logo": {
    "light": "/images/skyvern_logo_blackbg.png",
    "dark": "/logo/dark.png",
    "href": "https://skyvern.com"
  },
  "favicon": "/favicon.png",
  "search": {
    "prompt": "Search Skyvern docs..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "concepts"
            ]
          },
          {
            "group": "Use the app",
            "pages": [
              "cloud/quickstart",
              "cloud/studio",
              "cloud/runs",
              "cloud/integrations",
              "cloud/account"
            ]
          },
          {
            "group": "Build with code",
            "pages": [
              "developers/getting-started/quickstart",
              "developers/getting-started/mcp",
              "developers/browser-automation",
              "developers/production",
              "developers/preflight-checkout-check",
              "developers/troubleshooting",
              "developers/self-hosted/overview"
            ]
          },
          {
            "group": "Credentials & browsers",
            "pages": [
              "credentials",
              "browsers"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/blocks",
              "reference/actions",
              "reference/cli",
              "reference/configuration"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "api-reference/openapi.json"
      },
      {
        "tab": "SDK Reference",
        "groups": [
          {
            "group": "SDK",
            "pages": [
              "sdk-reference/overview",
              "sdk-reference/error-handling",
              "sdk-reference/complete-reference"
            ]
          },
          {
            "group": "Browser automation",
            "pages": [
              "sdk-reference/browser-automation/browsers",
              "sdk-reference/browser-automation/page",
              "sdk-reference/browser-automation/forms",
              "sdk-reference/browser-automation/frames",
              "sdk-reference/browser-automation/agent",
              "sdk-reference/browser-automation/complete-example"
            ]
          },
          {
            "group": "API client",
            "pages": [
              "sdk-reference/runs",
              "sdk-reference/agents",
              "sdk-reference/schedules",
              "sdk-reference/folders",
              "sdk-reference/browser-sessions",
              "sdk-reference/browser-profiles",
              "sdk-reference/credentials",
              "sdk-reference/files",
              "sdk-reference/artifacts",
              "sdk-reference/helpers"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Talk to us",
        "href": "https://www.skyvern.com/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.skyvern.com/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Skyvern-AI/skyvern",
      "discord": "https://discord.gg/skyvern",
      "twitter": "https://twitter.com/skyvernai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "cursor",
      "vscode",
      "mcp"
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://www.skyvern.com/docs"
    }
  },
  "css": "/style.css",
  "api": {
    "baseUrl": "https://api.skyvern.com",
    "auth": {
      "method": "key",
      "name": "x-api-key"
    },
    "playground": {
      "display": "interactive"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page doesn't exist. Try the [documentation home](/) or use search to find what you need."
    }
  },
