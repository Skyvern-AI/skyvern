     "next_loop_on_failure": false,
     "code": "await page.goto(\"https://example.com\")\nawait page.wait_for_selector(\"body p\")\nh1 = page.locator(\"h1\")\nif await h1.count() > 0:\n    heading = (await h1.first.inner_text()).strip()\n    source = \"h1\"\nelse:\n    heading = (await page.locator(\"p\").first.inner_text()).strip()\n    source = \"first_paragraph\"\nparagraph = (await page.locator(\"p\").first.inner_text()).strip()\ntitle = await page.title()\nlink_texts = await page.locator(\"a\").all_inner_texts()\nlinks = [t.strip() for t in link_texts if t.strip()]\nreturn {\"heading\": heading, \"source\": source, \"paragraph\": paragraph, \"title\": title, \"links\": links}",
     "parameters": [],
     "error_code_mapping": null,
     "prompt": "The example.com page is open, its main heading text is returned as heading, the first paragraph of the page is returned as paragraph, the browser tab title is returned as title, and the visible text of every link on the page is returned as links. The block opens https://example.com, waits for the page body text to render, reads the first h1 if one exists (otherwise the first paragraph), separately reads the first p element on the page, and collects the text of every a element.",
